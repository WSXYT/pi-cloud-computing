[Unit]
Description=Pi Cloud Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PI_CLOUD_DATA_DIR=/var/lib/pi-cloud
ExecStart=/usr/bin/node /opt/pi-cloud/dist/src/cli.js worker serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pi-cloud

[Install]
WantedBy=multi-user.target
