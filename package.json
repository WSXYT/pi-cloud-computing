{
  "name": "pi-cloud-computing",
  "version": "0.1.0",
  "description": "Run local Pi sessions on a self-hosted cloud worker and sync the results back safely.",
  "repository": {
    "type": "git",
    "url": "https://github.com/WSXYT/pi-cloud-computing.git"
  },
  "type": "module",
  "bin": {
    "pi-cloud": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "src",
    "deploy",
    "scripts/install.sh",
    "scripts/install.ps1",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/client.ts"
    ]
  },
  "scripts": {
    "clean": "npm run clean:dist",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "remote-execution"
  ],
  "license": "MIT",
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "24.12.4",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "8.18.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
